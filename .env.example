# USNEE v2 Environment Variables
# Copy this file to .env and fill in your values

# PostHog Analytics (EU cloud, anonymous events only)
# Events: app_open, record_created, safety_opened — no substance names, doses, or notes
# Get from: https://eu.posthog.com/project/settings
VITE_POSTHOG_KEY=your-posthog-project-api-key
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Telegram WebApp
# These are typically set by Telegram automatically
# TELEGRAM_BOT_TOKEN=
